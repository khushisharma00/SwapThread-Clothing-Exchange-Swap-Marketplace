# ==============================================================================
# SwapThread Monorepo Environment Configuration Template
# Copy this file to .env and configure your real secrets. NEVER commit .env to git.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or hosted MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/rewear

# JSON Web Token Secret
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Allowed Browser Origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary Cloud Storage (Free Tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial Administrator Credentials (Optional)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@swapthread.com
ADMIN_PASSWORD=

# Seed Script Password
SEED_PASSWORD=
