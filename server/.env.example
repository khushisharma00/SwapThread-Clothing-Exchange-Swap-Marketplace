# ==============================================================================
# SwapThread Server Environment Configuration Template
# Copy this file to .env and configure your real secrets. NEVER commit .env to git.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or hosted MongoDB)
# Local: mongodb://127.0.0.1:27017/rewear
# Hosted (Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/swapthread?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/rewear

# JSON Web Token Secret (Generate a strong random string)
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Allowed Browser Origins (comma-separated for CORS)
# Local: http://localhost:5173
# Production: https://swapthread.onrender.com,https://swapthread.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary Cloud Storage (Free Tier)
# Get from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or single connection URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Initial Administrator Provisioning (Optional environment setup)
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed Script Password (Optional custom password for pre-seeded test accounts)
SEED_PASSWORD=
